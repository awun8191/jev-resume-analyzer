# Never put this key in frontend variables or global shell exports.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=40
MAX_EXTRACTED_CHARS=60000
MAX_ANALYSIS_CHARS=40000
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
PARSER_TIMEOUT_SECONDS=15
