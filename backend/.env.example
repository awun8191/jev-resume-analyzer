# Never put this key in frontend variables or global shell exports.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=40
MAX_EXTRACTED_CHARS=60000
MAX_ANALYSIS_CHARS=40000
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
PARSER_TIMEOUT_SECONDS=15
# Leave the Upstash pair empty to fall back to a per-instance memory counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set a private salt in production so stored IP hashes cannot be guessed.
RATE_LIMIT_SALT=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYSES_PER_HOUR=10
RATE_LIMIT_EXTRACTS_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_GLOBAL_ANALYSES_PER_DAY=300
